rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'YOUR_ADMIN_EMAIL';
    }
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
      // ລູກຄ້າຫັກໄດ້ສະເພາະ stock ເທົ່ານັ້ນ ແລະ ຫຼຸດລົງ
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock;
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /costs/{id} {
      allow read, write: if isAdmin();
    }
    // ສະລິບໂອນເງິນ: ລູກຄ້າສ້າງໄດ້ພ້ອມອໍເດີເທົ່ານັ້ນ ແລະ ອ່ານໄດ້ສະເພາະ admin
    match /slips/{id} {
      allow create: if existsAfter(/databases/$(database)/documents/orders/$(id))
        && request.resource.data.keys().hasOnly(['img', 'createdAt'])
        && request.resource.data.img.size() < 700000;
      allow read, delete: if isAdmin();
    }
    match /receipts/{id} { allow read, write: if isAdmin(); }
    match /orders/{id} {
      allow create: if isAdmin() || (request.resource.data.status == 'new'
        && request.resource.data.get('paid', false) == false
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 20);
      allow read, update, delete: if isAdmin();
    }
  }
}
